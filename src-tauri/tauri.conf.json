{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cfharness Desktop",
  "mainBinaryName": "cfharness-desktop",
  "version": "0.1.0",
  "identifier": "io.cfharness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true,
      "capabilities": ["shell"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Vỏ desktop cho các hub cfharness",
    "longDescription": "Cfharness Desktop hiển thị giao diện web của các hub cfharness (local và cloud) trong một cửa sổ, kèm phần native: thanh chọn hub, đăng nhập tự động hub local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
